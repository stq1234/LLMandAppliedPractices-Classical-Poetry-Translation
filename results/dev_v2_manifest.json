  "poems": {
    "tang_01": {
      "id": "tang_01",
      "split": "dev",
      "genre": "tang_shi",
      "author": "杜牧",
      "title": "赠别二首·其二",
      "text": "多情却似总无情，\n唯觉尊前笑不成。\n蜡烛有心还惜别，\n替人垂泪到天明。",
      "source_url": "https://zh.wikisource.org/zh-hans/贈別二首_(杜牧)",
      "source_text_note": "据《赠别二首》页面“其二”全文；保留页面主读“唯觉尊前”，未取“但觉”异文；繁体字转为简体。",
      "semantic_notes": "惜别之情深，反而在酒席前笑不出来；随后把烛火写作有心惜别、代人流泪至天明。前两句的情绪反差与后两句的托物写情并置。“笑不成”没有明示主语，可理解为席间离别者，不将人物身份或视角限定为单一读法。",
      "critical_units": [
        {
          "id": "tang_01_u1",
          "source_span": "多情却似总无情",
          "meaning": "深情在表面上呈现为仿佛无情，构成反常的情绪转折。"
        },
        {
          "id": "tang_01_u2",
          "source_span": "尊前笑不成",
          "meaning": "临别席前笑不出来，句中人物主语省略。"
        },
        {
          "id": "tang_01_u3",
          "source_span": "蜡烛有心",
          "meaning": "将烛写成具有惜别心意的对象。"
        },
        {
          "id": "tang_01_u4",
          "source_span": "替人垂泪到天明",
          "meaning": "以烛泪代写离别者彻夜不止的泪意。"
        }
      ],
      "phenomena": [
        "情感反转",
        "拟人",
        "主语省略",
        "借物抒情"
      ]
    },
    "tang_02": {
      "id": "tang_02",
      "split": "dev",
      "genre": "tang_shi",
      "author": "李商隐",
      "title": "夜雨寄北",
      "text": "君问归期未有期，\n巴山夜雨涨秋池。\n何当共剪西窗烛，\n却话巴山夜雨时。",
      "source_url": "https://zh.wikisource.org/wiki/夜雨寄北",
      "source_text_note": "据《夜雨寄北》页面所列《李义山诗集（四部丛刊本）》等收录文本；采用“何当”主读，不取“何时”异文；繁体字转为简体。",
      "semantic_notes": "诗中先写有人询问归期而答复未定，再落到巴山夜雨涨满秋池的眼前景象；后两句转向设想将来相聚时回谈此刻的雨夜。诗没有说明“君”的身份或性别，也不把设想当作已经发生的事实。",
      "critical_units": [
        {
          "id": "tang_02_u1",
          "source_span": "君问归期未有期",
          "meaning": "询问归期却没有可确定的日期；对话双方身份未展开。"
        },
        {
          "id": "tang_02_u2",
          "source_span": "巴山夜雨涨秋池",
          "meaning": "以当地秋夜雨势和水涨写当前处境。"
        },
        {
          "id": "tang_02_u3",
          "source_span": "何当共剪西窗烛",
          "meaning": "盼望将来共同相聚，具体相聚时间未定。"
        },
        {
          "id": "tang_02_u4",
          "source_span": "却话巴山夜雨时",
          "meaning": "设想未来回头谈论眼下的巴山雨夜，形成时间视角转换。"
        }
      ],
      "phenomena": [
        "时间视角转换",
        "情感反转",
        "文化意象",
        "主语省略"
      ]
    },
    "song_01": {
      "id": "song_01",
      "split": "dev",
      "genre": "song_ci",
      "author": "苏轼",
      "title": "江城子·乙卯正月二十日夜记梦",
      "text": "十年生死两茫茫，\n不思量，自难忘。\n千里孤坟，无处话凄凉。",
      "source_url": "https://zh.wikisource.org/zh-hans/江城子_(苏轼)/江城子_(乙卯正月二十日夜记梦)",
      "source_text_note": "取《东坡全集》所收词开篇四个短句，为连续的自足片段；简体字和标点按页面正文整理。",
      "semantic_notes": "词中写十年生死相隔，称自己即使不刻意思量也自然难忘；千里之外的孤坟使凄凉无处诉说。“不思量”与“自难忘”并置，强调记忆并非完全由意志控制；片段未明示被思念者的身份。",
      "critical_units": [
        {
          "id": "song_01_u1",
          "source_span": "十年生死两茫茫",
          "meaning": "以十年和生死相隔概括漫长离别。"
        },
        {
          "id": "song_01_u2",
          "source_span": "不思量，自难忘",
          "meaning": "有意不去想与自然无法忘却并置。"
        },
        {
          "id": "song_01_u3",
          "source_span": "千里孤坟",
          "meaning": "以远隔千里的孤坟具体化生死距离。"
        },
        {
          "id": "song_01_u4",
          "source_span": "无处话凄凉",
          "meaning": "表达凄凉无从倾诉，未限定倾诉地点或对象。"
        }
      ],
      "phenomena": [
        "情感反转",
        "主语省略",
        "文化意象",
        "语义歧义"
      ]
    },
    "song_02": {
      "id": "song_02",
      "split": "dev",
      "genre": "song_ci",
      "author": "晏殊",
      "title": "浣溪沙·一曲新词酒一杯",
      "text": "一曲新词酒一杯，\n去年天气旧亭台。\n夕阳西下几时回？\n无可奈何花落去，\n似曾相识燕归来。\n小园香径独徘徊。",
      "source_url": "https://zh.wikisource.org/wiki/浣溪沙_(晏殊)",
      "source_text_note": "据《浣溪沙（一曲新词酒一杯）》全文；保留页面主读，按六句分行并转为简体。",
      "semantic_notes": "新词与酒引出旧日亭台和去年的天气，夕阳西下后发问何时再回；花落令人无奈，归燕却带来似曾相识之感。结尾写人在小园独自徘徊，重复出现的季候景象与无法挽回的流逝并存。",
      "critical_units": [
        {
          "id": "song_02_u1",
          "source_span": "去年天气旧亭台",
          "meaning": "眼前景物牵出对去年时日的回想。"
        },
        {
          "id": "song_02_u2",
          "source_span": "夕阳西下几时回",
          "meaning": "借日落发问逝去时光何时能返。"
        },
        {
          "id": "song_02_u3",
          "source_span": "无可奈何花落去",
          "meaning": "面对花落和春光消逝感到无力挽留。"
        },
        {
          "id": "song_02_u4",
          "source_span": "似曾相识燕归来",
          "meaning": "归燕带来熟悉感，与花落不可逆形成对照。"
        }
      ],
      "phenomena": [
        "情感反转",
        "时间视角转换",
        "意象并置",
        "主语省略"
      ]
    }
